# Standalone vault: gf login && npm run dev
# Vite proxies /control-plane and attaches a fresh `gf token`. Do not paste JWTs.

# Optional — omit to use the same-origin proxy (recommended):
# VITE_CONTROLPLANE_URL=/control-plane

# Optional override if Control Plane origin must differ from `gf env`:
# VITE_CONTROLPLANE_PROXY_TARGET=https://platform.stage.groundfloor.cloud

VITE_PORT=4175
